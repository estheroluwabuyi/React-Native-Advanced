{
  "expo": {
    "name": "my-app",
    "slug": "my-app",
    "scheme": "my-app",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/images/coffee-icon.png"
    },
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/coffee-ill.png",
          "backgroundColor": "#000000",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "expo-router"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/coffee-icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/coffee-ill.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.myapp"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "205d2e91-69d6-49f5-8b3b-0d68a7aa98a0"
      }
    }
  }
}
